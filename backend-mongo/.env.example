NODE_ENV=development
PORT=3000
APP_NAME=School ERP

MONGODB_URI=mongodb://localhost:27017/school_erp

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated emails allowed to use the ERP module while feature-flagged (empty = any ADMIN)
SUPER_ADMIN_EMAILS=

# Optional integrations (features stay disabled when blank)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Firebase push: place the service-account JSON at backend-mongo/config/firebase-service-account.json (gitignored)

# used by `npm run seed`
SEED_ORG_EMAIL=org@platform.local
SEED_ORG_PASSWORD=ChangeMe@123
SEED_SCHOOL_NAME=Demo School
SEED_SCHOOL_CODE=demo-school
SEED_ADMIN_EMAIL=admin@school.local
SEED_ADMIN_PASSWORD=ChangeMe@123
