# Backend the dev server proxies /api to (mongo: 3000)
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# Production API origin (leave empty to use same origin)
VITE_API_URL=

# Branding (per school)
VITE_PRODUCT_NAME=School ERP
VITE_SCHOOL_NAME=Your School Name
VITE_SCHOOL_MEDIUM=
VITE_SCHOOL_ADDRESS=School address, City, State
VITE_SCHOOL_PHONE=
VITE_SCHOOL_EMAIL=
VITE_SCHOOL_WEBSITE=
VITE_SCHOOL_LOGO=/logo.svg
# Comma-separated emails that see the ERP module while it is feature-flagged (empty = every ADMIN)
VITE_SUPER_ADMIN_EMAILS=
