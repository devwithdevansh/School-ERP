NODE_ENV=development
PORT=3001
APP_NAME=School ERP

# Supabase project (Settings -> API). Use the SERVICE ROLE key - server side only, never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated emails allowed to use the ERP module while feature-flagged (empty = any ADMIN)
SUPER_ADMIN_EMAILS=

# used by `npm run seed`
SEED_ORG_EMAIL=org@platform.local
SEED_ORG_PASSWORD=ChangeMe@123
SEED_SCHOOL_NAME=Demo School
SEED_SCHOOL_CODE=demo-school
SEED_ADMIN_EMAIL=admin@school.local
SEED_ADMIN_PASSWORD=ChangeMe@123
