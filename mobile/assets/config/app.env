# School Connect runtime configuration (bundled with the app; contains NO secrets).
# Override per school / per build by editing this file, or at run time with:
#   flutter run --dart-define=BACKEND_URL=https://api.myschool.com

# Backend root WITHOUT /api/v1. Empty = local dev default
# (Android emulator http://10.0.2.2:3000, iOS simulator / web http://localhost:3000).
BACKEND_URL=

# --- Branding (what parents see) ---
APP_NAME=School Connect
# Leave SCHOOL_NAME empty to show the school name the backend reports at login.
SCHOOL_NAME=
SCHOOL_TAGLINE=Learning, together
# One short word shown big on the splash screen (e.g. the school's short name)
SCHOOL_WORDMARK=SCHOOL
SCHOOL_ADDRESS=School address line, City, State
SCHOOL_PHONE=
SCHOOL_EMAIL=
SCHOOL_WEBSITE=

# Online fee payments (Razorpay *key id* - public by design; never put the key SECRET here).
RAZORPAY_KEY_ID=
